{
  "schema": "wynai.skill/v1",
  "id": "sales-baseline",
  "version": "1.0.0",
  "name": "销售基础分析",
  "scope": "dataset",
  "datasetIds": [
    "2b445034-38fe-4350-9cab-b7684c28b5f8"
  ],
  "triggers": [
    "销售",
    "销售额",
    "收入",
    "利润",
