{
  "schema": "wynai.skill/v1",
  "id": "sales-baseline",
  "version": "1.3.0",
  "name": "销售基础分析",
  "scope": "dataset",
  "datasetIds": [
    "2b445034-38fe-4350-9cab-b7684c28b5f8"
  ],
  "triggers": [
    "销售",
    "销售额",
    "收入",
    "利润",
    "客户地区",
    "客户集中度",
    "销售经理",
    "销售员",
    "业务员",
    "销售代表",
    "订单数",
    "订单数量",
    "大区",
    "毛利率",
    "客单价"
  ],
  "metrics": [
    {
      "name": "销售额",
      "field": "订单金额",
      "aggregation": "sum",
      "definition": "订单金额求和",
      "id": "revenue",
      "concept": "revenue",
      "synonyms": [
        "销售收入",
        "营收",
        "收入"
      ],
      "unitFamily": "currency"
    },
    {
      "name": "利润",
      "field": "订单利润",
      "aggregation": "sum",
      "definition": "订单利润求和",
      "id": "profit",
      "concept": "profit",
      "synonyms": [
        "毛利",
        "盈利"
      ],
      "unitFamily": "currency"
    },
    {
      "name": "订单数",
      "field": "订单编号",
      "aggregation": "distinctCount",
      "definition": "订单编号去重计数",
      "id": "orderCount",
      "concept": "orderCount",
      "synonyms": [
        "订单数量",
        "订单量",
        "订单笔数",
        "下单数"
      ],
      "unitFamily": "count"
    },
    {
      "id": "grossMarginRate",
      "concept": "grossMarginRate",
      "name": "毛利率",
      "definition": "汇总粒度下订单利润合计除以订单金额合计；禁止先计算明细比例再平均",
      "synonyms": [
        "销售毛利率"
      ],
      "unitFamily": "percentage",
      "outputAlias": "gross_margin_rate",
      "formula": {
        "schema": "wynai.metric-formula/v1",
        "operator": "ratio",
        "inputs": [
          "profit",
          "revenue"
        ],
        "aggregationOrder": "aggregate-then-calculate",
        "zeroDivision": "null"
      }
    },
    {
      "id": "averageOrderValue",
      "concept": "averageOrderValue",
      "name": "客单价",
      "definition": "汇总粒度下订单金额合计除以订单编号去重计数；表示平均每笔订单金额，不按客户数计算",
      "synonyms": [
        "平均客单价",
        "平均订单金额",
        "每单金额",
        "订单均价"
      ],
      "unitFamily": "currency",
      "outputAlias": "average_order_value",
      "formula": {
        "schema": "wynai.metric-formula/v1",
        "operator": "ratio",
        "inputs": [
          "revenue",
          "orderCount"
        ],
        "aggregationOrder": "aggregate-then-calculate",
        "zeroDivision": "null"
      }
    }
  ],
  "workflows": [
    {
      "id": "sales-trend",
      "steps": [
        "time-trend",
        "region-drilldown",
        "customer-drilldown"
      ]
    }
  ],
  "forbidden": [
    "将订单明细样本当作全量总额",
    "将订单金额直接解释为利润",
    "将毛利率计算为行级利润率的平均值",
    "将客单价按客户数计算，或将订单明细金额直接平均"
  ],
  "status": "approved",
  "businessEntities": [
    {
      "id": "salesManager",
      "concept": "employee",
      "name": "销售经理",
      "field": "员工姓名",
      "synonyms": [
        "销售经理",
        "销售员",
        "业务员",
        "销售代表"
      ]
    },
    {
      "id": "salesRegion",
      "concept": "region",
      "name": "销售大区",
      "field": "客户地区",
      "synonyms": [
        "大区",
        "销售大区",
        "区域",
        "地区"
      ]
    }
  ],
  "diagnostics": [
    {
      "id": "revenue-decline",
      "name": "销售额下降诊断",
      "triggers": [
        "下降",
        "下滑",
        "减少"
      ],
      "requiredEvidence": [
        "revenue-trend",
        "region-contribution",
        "customer-concentration"
      ],
      "riskRules": [
        {
          "id": "margin-compression",
          "when": "利润率下降且销售额未同步下降",
          "severity": "warning",
          "action": "检查折扣、成本和产品组合"
        }
      ],
      "playbook": [
        "确认时间范围和同比/环比口径",
        "定位区域、客户和产品贡献",
        "回查异常对象明细并指定责任人"
      ]
    }
  ],
  "assumptions": [
    "销售额与利润均按已审批 Skill 口径聚合"
  ],
  "evaluationRefs": [
    "sales-golden-diagnostics-v1"
  ]
}
