    "客户集中度",
    "销售经理",
    "销售员",
    "业务员",
    "销售代表"
  ],
  "metrics": [
    {
      "name": "销售额",
      "field": "订单金额",
      "aggregation": "sum",
      "definition": "订单金额求和"
    },
    {
      "name": "利润",
      "field": "订单利润",
      "aggregation": "sum",
      "definition": "订单利润求和"
    },
    {
      "name": "订单数",
      "field": "订单编号",
      "aggregation": "distinctCount",
      "definition": "订单编号去重计数"
    }
  ],
  "workflows": [
    {
      "id": "sales-trend",
      "steps": [
        "time-trend",
        "region-drilldown",
        "customer-drilldown"
      ]
    }
  ],
  "forbidden": [
    "将订单明细样本当作全量总额",
    "将订单金额直接解释为利润"
  ],
  "status": "approved",
  "businessEntities": [
    {
      "id": "salesManager",
      "concept": "employee",
      "name": "销售经理",
      "field": "员工姓名",
      "synonyms": [
        "销售经理",
        "销售员",
        "业务员",
        "销售代表"
      ]
    }
  ]
}
