  "workflows": [
    {
      "id": "rank-then-drilldown",
      "name": "先排名后下钻",
      "steps": [
        "先按用户指定的主维度（例如产品名称）聚合销售额并排序取TopN",
        "固定TopN主维度值",
        "再在同一时间范围和其他筛选条件下按客户名称下钻",
        "下钻维度不得反向改变TopN主维度的排名"
      ]
    },
    {
      "id": "slice-share",
      "name": "切片占比",
      "steps": [
        "分子使用用户指定切片（例如产品小类=Risk Management）和时间范围计算销售额",
        "分母复用同一时间范围和其他筛选条件，但移除该切片字段过滤，计算全部产品销售额",
        "占比=分子/分母；分母为0时返回无法计算",
        "若去年、全年、自然年和财年口径不明确，先提出澄清问题"
      ]
    },
    {
      "id": "multi-value-filter",
      "name": "多值字段筛选",
      "steps": [
        "不同字段之间默认使用AND",
        "同一字段多个候选值默认使用OR/IN",
        "多值字段使用containsAny或containsAll语义，不把数组字符串当作普通标量等值",
        "MNC映射到客户类型的规范成员值：Multinational Corporation（MNC）；POE映射到Private Entity（POE）；实际源值以Wyn返回值为准，并通过多值字符串包含语义筛选"
      ]
    },
    {
      "id": "recurring-filter",
      "name": "recurring 字段筛选",
      "steps": [
        "分析 recurring 时优先使用 recurring 字段，不使用商机来源字段替代",
        "裸词 recurring 使用 recurring 包含 Yes 的条件",
        "老客户、老合同续约使用 recurring = Yes - Continuous",
        "老客户、新合同使用 recurring = Yes - New Win",
        "不是 recurring 使用 recurring = No",
        "项目名单问题默认包含 pipelineName 维度"
      ]
    }
  ],
  "forbidden": [
    "不得把商机数量解释为Opportunity_amount_CNY求和或明细行数",
    "不得把客户类型多值字符串直接与简称或全称做严格等值比较；必须使用多值字符串包含语义",
    "不得对不同字段的筛选使用OR，除非用户明确要求",
    "不得用字符串contains替代规范枚举或多值成员匹配",
    "不得把产品下钻维度加入排名分组后再声称得到产品Top1",
    "不得在切片占比中使用已过滤切片自身作为分母",
    "目标数据集没有已确认的利润字段，不得编造利润或毛利率结果",
    "不得把自然年自动改写为财年，也不得把去年自动解释为固定财年而不检查当前日期和上下文",
    "分析 recurring 时不得改用商机来源 = Recurring",
    "不得生成 recurring = recurring 或 recurring = 是"
  ],
  "assumptions": [
    "默认金额指标使用Opportunity_amount_CNY；用户明确指定USD时使用Opportunity_amount_USD。",
    "商机唯一业务标识为pipelineCode，商机数量使用distinctCount。",
    "目标数据集的授权边界由Wyn平台决定，本Skill不重复执行权限过滤。",
    "客户类型是多值字符串字段，不解析为JSON；MNC和POE是成员简称，最终过滤值使用Markdown字典中的数据集实际源值，并通过多值字符串包含语义执行。",
    "不同字段的筛选默认AND，同字段多个值默认OR/IN。",
    "产品层级为产品大类、产品小类、产品名称；用户只说产品时优先使用产品名称。",
    "未明确自然年时，去年/前年/今年按赢单财年解释；用户明确自然年时覆盖数据集默认口径。",
    "recurring 的业务含义来自 recurring 字段字典，不等同于商机来源。"
  ],
  "evaluationRefs": [
