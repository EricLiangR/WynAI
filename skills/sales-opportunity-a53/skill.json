      "matchMode": "exact",
      "notes": "recurring 精确业务成员。"
    },
    {
      "field": "recurring",
      "concept": "recurring",
      "canonicalValue": "Yes - New Win",
      "synonyms": [
        "老客户、新合同",
        "老客户新合同"
      ],
      "matchMode": "exact",
      "notes": "recurring 精确业务成员。"
    },
    {
      "field": "recurring",
      "concept": "recurring",
      "canonicalValue": "No",
      "synonyms": [
        "不是recurring",
        "非recurring",
        "不是 recurring"
      ],
      "matchMode": "exact",
      "notes": "recurring 非 recurring 成员。"
    }
  ],
  "metrics": [
    {
      "id": "revenueCny",
      "concept": "revenue",
      "name": "销售额",
      "field": "Opportunity_amount_CNY",
      "aggregation": "sum",
      "definition": "Opportunity_amount_CNY 求和，默认作为人民币销售额/商机金额。",
      "synonyms": [
        "销售收入",
        "营收",
        "收入",
        "商机金额",
        "金额",
        "订单金额"
