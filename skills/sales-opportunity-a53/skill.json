  "temporalSemantics": [
    {
      "id": "won-fiscal-year",
      "meaning": "赢单财年使用赢单财年字段，字段值为财年末两位数字，例如25表示FY25。目标数据集财年按6月1日至次年5月31日划分。",
      "grain": "year",
      "expressions": [
        "按财年",
        "每个财年",
        "各财年",
        "所有财年",
        "历年",
        "按赢单财年"
      ],
      "ambiguity": "未明确自然年时使用数据集默认赢单财年；用户明确自然年时使用赢单日期覆盖默认口径。"
    },
    {
      "id": "won-quarter",
      "field": "赢单季度",
      "meaning": "赢单季度字段值1至4分别表示FY内季度：Q1为6月至8月，Q2为9月至11月，Q3为12月至次年2月，Q4为3月至5月。",
      "grain": "quarter",
      "expressions": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "第一季度",
        "第二季度",
        "第三季度",
        "第四季度",
        "赢单季度",
        "按赢单季度",
        "按季度",
        "季度统计"
      ],
      "ambiguity": "只出现季度而未出现年份时，不自动猜测年份；先确认自然季度或财年季度。"
    }
  ],
  "relativeTemporalSemantics": [
    {
      "id": "last-fiscal-year",
      "meaning": "去年在明确采用财年口径时表示上一赢单财年。",
      "unit": "year",
      "offset": -1,
      "expressions": [
        "去年",
        "上财年"
      ],
      "ambiguity": "未明确自然年时按数据集默认赢单财年处理。"
    },
    {
      "id": "prior-fiscal-year",
      "meaning": "前年在明确采用财年口径时表示上上赢单财年。",
      "unit": "year",
      "offset": -2,
      "expressions": [
        "前年",
        "上上财年"
      ],
      "ambiguity": "未明确自然年时按数据集默认赢单财年处理。"
    }
  ],
