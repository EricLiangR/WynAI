  "fieldSemantics": [
    {
      "field": "客户类型",
      "type": "string",
      "storage": "delimited-text",
      "multiValue": true,
      "queryOperators": [
        "containsAny",
        "containsAll",
        "notContainsAny",
        "notContainsAll"
      ],
      "description": "普通字符串字段；一个值可能包含多个客户类型成员。Wyn 返回的是字符串，不解析为 JSON 数组。先用 Markdown 字典把简称或全称映射为数据集实际成员文本，再按字符串成员包含语义筛选。"
    },
    {
      "field": "recurring",
      "type": "string",
      "storage": "scalar",
      "multiValue": false,
      "queryOperators": [
        "eq",
        "containsAny"
      ],
      "description": "普通字符串枚举字段；裸词 recurring 使用 containsAny=Yes，精确业务含义使用 Yes - Continuous、Yes - New Win 或 No。"
    }
  ],
