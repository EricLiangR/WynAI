      "aggregation": "sum",
      "definition": "预计收入_CNY 求和；不得与已赢单销售额混用。",
      "synonyms": [
        "预计销售额",
        "预计商机收入",
        "预测收入"
      ],
      "unitFamily": "currency",
      "outputAlias": "expected_revenue_cny"
    },
    {
      "id": "expectedRevenueUsd",
      "concept": "expectedRevenue",
      "name": "预计收入（USD）",
      "field": "预计收入_USD",
      "aggregation": "sum",
      "definition": "只有用户明确指定美元或USD时使用。",
      "synonyms": [
        "预计美元销售额",
        "预计美元收入"
      ],
      "unitFamily": "currency",
      "outputAlias": "expected_revenue_usd"
    },
    {
      "id": "opportunityCount",
      "concept": "opportunityCount",
      "name": "商机数量",
      "field": "pipelineCode",
      "aggregation": "distinctCount",
      "definition": "pipelineCode 去重计数。商机数量默认不是金额求和，也不是明细行数。",
      "synonyms": [
        "商机数",
        "商机个数",
        "商机数量",
        "有多少个商机",
        "pipeline数量"
      ],
      "unitFamily": "count",
      "outputAlias": "opportunity_count"
    }
