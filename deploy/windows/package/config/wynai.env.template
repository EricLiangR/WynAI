# Wyn AI Windows deployment configuration
# Restart the process or service after changing this file.

# LAN deployment default. Use 127.0.0.1 for local-only access.
HOST=0.0.0.0
PORT=8787
WYN_VIEW_PROXY_PORT=8788

# Wyn server
WYN_BASE_URL=http://localhost:51980
WYN_TOKEN=

# OpenAI-compatible LLM service. The application can start when these are empty,
# but AI planning, critic and report generation will be unavailable.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=