WYN_BASE_URL=http://localhost:51980
WYN_TOKEN=replace_with_your_wyn_token
HOST=127.0.0.1
PORT=8787
WYN_VIEW_PROXY_PORT=8788
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace_with_your_llm_key
LLM_MODEL=your_model_name
LLM_TIMEOUT_MS=180000
INTENT_LLM_TIMEOUT_MS=10000
LLM_CONNECT_TIMEOUT_MS=3000
LLM_RESPONSE_HEADER_WARNING_MS=15000
LLM_RESPONSE_HEADER_TIMEOUT_MS=180000
LLM_RESPONSE_BODY_TIMEOUT_MS=180000
LLM_INSIGHT_PLANNER_TIMEOUT_MS=45000
LLM_INSIGHT_CRITIC_TIMEOUT_MS=35000
LLM_INSIGHT_NARRATOR_TIMEOUT_MS=45000
LLM_INSIGHT_NARRATOR_REPAIR_TIMEOUT_MS=90000
LLM_AGENT_REPORT_TIMEOUT_MS=45000
LLM_ENABLE_THINKING=false

# 运行时诊断数据（insight-diagnostics、operation-events）按时间滚动保留的天数。
# 默认 7 天：启动时与每次写入时删除超出窗口的记录，避免诊断日志无限增长。
WYN_AI_RUNTIME_RETENTION_DAYS=7
