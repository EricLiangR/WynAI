{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wynai.local/schemas/wynai.insight-document.v1.schema.json",
  "title": "WynAI Insight Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "documentType", "title", "scope", "blocks", "evidence", "nextQuestions"],
  "properties": {
    "schema": { "const": "wynai.insight-document/v1" },
    "documentType": { "type": "string" },
    "title": { "type": "string", "maxLength": 200 },
    "scope": { "type": "object", "required": ["datasetId", "datasets", "filters", "timeRange", "accuracy", "isSample", "isTruncated"], "properties": { "datasetId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "datasets": { "type": "array" }, "filters": { "type": "array" }, "timeRange": {}, "accuracy": { "enum": ["exact", "sample", "estimated", "unknown"] }, "isSample": { "type": "boolean" }, "isTruncated": { "type": "boolean" } } },
    "blocks": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string" }, "type": { "enum": ["kpi", "text", "ai-narrative", "manual-content", "chart", "table", "filter-summary", "metric-definition", "warning", "divider"] }, "dataRef": { "type": "string" }, "evidenceIds": { "type": "array" } } } },
    "evidence": { "type": "array", "maxItems": 100 },
    "nextQuestions": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "followUpActions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/followUpAction" } }
  },
  "$defs": {
    "followUpAction": { "type": "object", "required": ["schema", "id", "kind", "label", "question", "source", "confidence", "basedOn"], "properties": { "schema": { "const": "wynai.follow-up-action/v1" }, "id": { "type": "string" }, "kind": { "enum": ["replace-metric", "add-dimension", "add-time-grain", "rank"] }, "label": { "type": "string" }, "question": { "type": "string" }, "source": { "enum": ["semantic-catalog", "query-plan", "result-shape"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "basedOn": { "type": "object" } } }
  }
}
