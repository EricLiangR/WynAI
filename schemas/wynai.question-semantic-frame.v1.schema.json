{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wynai.question-semantic-frame/v1",
  "title": "WynAI QuestionSemanticFrame v1",
  "type": "object",
  "required": ["schema", "question", "metrics", "dimensions", "time", "accumulation", "ranking", "requestedOutputs", "complexity"],
  "properties": {
    "schema": { "const": "wynai.question-semantic-frame/v1" },
    "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "metrics": { "type": "array", "items": { "type": "object", "required": ["concept", "source", "required"] } },
    "dimensions": { "type": "array", "items": { "type": "object", "required": ["concept", "level", "entity", "source", "required"] } },
    "time": {
      "type": "object",
      "required": ["explicit", "periods", "grouping", "aggregationMode"],
      "properties": {
        "explicit": { "type": "boolean" },
        "source": { "type": ["string", "null"] },
        "periods": { "type": "array" },
        "range": { "type": ["object", "null"] },
        "grouping": { "enum": [null, "day", "week", "month", "quarter", "year"] },
        "aggregationMode": { "enum": ["period-total", "cumulative-window"] }
      }
    },
    "accumulation": { "type": "object", "required": ["mode", "required"] },
    "ranking": { "type": ["object", "null"] },
    "groupingQuantifiers": { "type": "array", "items": { "type": "string" } },
    "requestedOutputs": { "type": "array" },
    "complexity": { "type": "integer", "minimum": 0 }
  }
}
