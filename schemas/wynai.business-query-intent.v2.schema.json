{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wynai.business-query-intent/v2",
  "title": "WynAI BusinessQueryIntent v2",
  "type": "object",
  "required": [
    "schema",
    "businessQuestion",
    "metrics",
    "dimensions",
    "filters",
    "resultFilters",
    "time",
    "expectedResult",
    "constraints"
  ],
  "properties": {
    "schema": {
      "const": "wynai.business-query-intent/v2"
    },
    "intentId": {
      "type": "string"
    },
    "businessQuestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "source": {
      "type": "object"
    },
    "dataset": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {}
      }
    },
    "transition": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "replace",
            "modify"
          ]
        },
        "inheritsPriorContext": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "aggregation",
          "alias"
        ],
        "properties": {
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "aggregation": {
            "enum": [
              "sum",
              "average",
              "min",
              "max",
              "countRows",
              "distinctCount"
            ]
          },
          "alias": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "unitFamily": {
            "type": [
              "string",
              "null"
            ]
          },
          "metricId": {
            "type": [
              "string",
              "null"
            ]
          },
          "internal": {
            "type": "boolean"
          }
        }
      }
    },
    "derivedMetrics": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "type",
          "alias"
        ],
        "properties": {
          "type": {
            "enum": [
              "yoy",
              "mom",
              "share-of-total",
              "formula"
            ]
          },
          "sourceAlias": {
            "type": "string"
          },
          "shareDimensionAlias": {
            "type": "string"
          },
          "partitionBy": {
            "type": "array",
            "items": { "type": "string" }
          },
          "denominatorScope": {
            "enum": ["filtered-result"]
          },
          "alias": {
            "type": "string"
          },
          "resultType": {
            "enum": [
              "percentage",
              "number"
            ]
          },
          "operator": {
            "enum": [
              "ratio",
              "difference",
              "percentage"
            ]
          },
          "metricId": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "metricId",
                "sourceAlias"
              ],
              "properties": {
                "metricId": {
                  "type": "string"
                },
                "sourceAlias": {
                  "type": "string"
                }
              }
            }
          },
          "unitFamily": {
            "type": [
              "string",
              "null"
            ]
          },
          "aggregationOrder": {
            "const": "aggregate-then-calculate"
          },
          "zeroDivision": {
            "enum": [
              "null",
              "zero"
            ]
          },
          "skillRef": {
            "type": "string"
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "field",
          "alias"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "grain": {
            "enum": [
              null,
              "day",
              "week",
              "month",
              "quarter",
              "year"
            ]
          },
          "concept": {
            "type": "string"
          },
          "internal": {
            "type": "boolean"
          }
        }
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 8
    },
    "governedMappingEvidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["schema", "sourcePhrase", "field", "operator", "canonicalValue", "evidenceSource"],
        "properties": {
          "schema": { "const": "wynai.governed-mapping-evidence/v1" },
          "sourcePhrase": { "type": "string" },
          "field": { "type": "string" },
          "concept": { "type": ["string", "null"] },
          "operator": { "type": "string" },
          "canonicalValue": { "type": "string" },
          "skillRef": { "type": ["string", "null"] },
          "evidenceSource": { "const": "skill-value-mapping" }
        },
        "additionalProperties": false
      }
    },
    "resultFilters": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["field", "operator", "value"],
        "properties": {
          "field": { "type": "string" },
          "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte"] },
          "value": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "time": {
      "type": "object",
      "required": [
        "timeZone",
        "periods",
        "grain"
      ],
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "calendar": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "periods": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "range": {
          "type": [
            "object",
            "null"
          ]
        },
        "grain": {
          "enum": [
            null,
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        },
        "explicit": {
          "type": "boolean"
        },
        "scopeExplicit": {
          "type": "boolean"
        },
        "groupingExplicit": {
          "type": "boolean"
        },
        "scopePolicy": {
          "enum": [
            "unspecified",
            "explicit-periods",
            "latest-complete-years"
          ]
        },
        "modifier": {
          "type": "boolean"
        },
        "groupedYears": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "periodKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "grouping": {
          "enum": [
            null,
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        },
        "grainRole": {
          "enum": [
            null,
            "analysis",
            "derivation"
          ]
        }
      }
    },
    "ranking": {
      "type": [
        "object",
        "null"
      ]
    },
    "visualizationIntent": {
      "type": ["object", "null"],
      "properties": {
        "type": { "enum": ["none", "line", "column", "bar", "pie", "donut", "combo", "stacked-column"] },
        "source": { "type": "string" },
        "explicit": { "type": "boolean" }
      }
    },
    "semanticFrame": {
      "type": "object",
      "required": [
        "schema",
        "question",
        "metrics",
        "dimensions",
        "time",
        "requestedOutputs"
      ],
      "properties": {
        "schema": {
          "enum": [
            "wynai.question-semantic-frame/v1",
            "wynai.question-semantic-frame/v2"
          ]
        },
        "question": {
          "type": "string"
        },
        "metrics": {
          "type": "array"
        },
        "dimensions": {
          "type": "array"
        },
        "time": {
          "type": "object"
        },
        "accumulation": {
          "type": "object"
        },
        "ranking": {
          "type": [
            "object",
            "null"
          ]
        },
        "derivedMetrics": {
          "type": "array"
        },
        "visualizationIntent": {
          "type": ["object", "null"]
        },
        "groupingQuantifiers": {
          "type": "array"
        },
        "requestedOutputs": {
          "type": "array"
        },
        "complexity": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expectedResult": {
      "type": "object",
      "required": [
        "shape",
        "minimumRows",
        "maximumRows",
        "requiredPeriods",
        "requiredMetrics",
        "requiredDimensions",
        "timeZone"
      ]
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "required",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "normalized": {},
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skillRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
